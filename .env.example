# Server Port
PORT=3040

# ============================================================================
# OPTION 1: Official Telegram Bot API (100% Ban-Proof — Recommended)
# ============================================================================
# 1. Create a bot via @BotFather and paste its token here.
# 2. Add the bot as an Admin in your Group or Channel with "Invite Users via Link".
TELEGRAM_BOT_TOKEN=
# Target Group or Channel ID (e.g. -1001234567890 or @your_channel_username)
TELEGRAM_CHAT_ID=
# Optional welcome DM sent when a user requests to join via Option 1 link
TELEGRAM_WELCOME_TEXT=Welcome {name}! Your request to join has been approved.

# ============================================================================
# OPTION 2: MTProto Client API (Add Contact + Direct Invite with Safeguards)
# ============================================================================
# 1. Get api_id and api_hash from https://my.telegram.org
# 2. Run `npm run login:mtproto` once to generate your TELEGRAM_STRING_SESSION
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=

# Safety Caps for Option 2 (Protects account from PEER_FLOOD)
MTPROTO_MAX_INVITES_PER_HOUR=4
MTPROTO_MAX_INVITES_PER_DAY=15
MTPROTO_MAX_CONTACTS_PER_DAY=12
MTPROTO_MIN_DELAY_MS=60000
MTPROTO_MAX_DELAY_MS=150000
